  "apis": {
    "match_results": {
      "endpoint": "/result",
      "method": "GET",
      "description": "Fetch completed match results for a given season and match day",
      "query_params": {
        "seasonId": {
          "type": "string",
          "format": "vf:season:{id}",
          "example": "vf:season:3036422",
          "required": true,
          "description": "Season identifier"
        },
        "matchDay": {
          "type": "integer",
          "required": true,
          "description": "Match day within the season (1-based)"
        }
      },
      "response": {
        "bizCode": {
          "type": "integer",
          "description": "Business code, 10000 = success",
          "observed_values": [
            10000
          ]
        },
        "message": {
          "type": "string",
          "description": "Human-readable status message",
          "observed_values": [
            "success"
          ]
        },
        "innerMsg": {
          "type": "string",
          "description": "Internal status message",
          "observed_values": [
            "success"
          ]
        },
        "data": {
          "type": "object",
          "description": "Paginated results container",
          "fields": {
            "current": {
              "type": "object",
              "description": "Current page of results",
              "fields": {
                "matchDay": {
                  "type": "integer",
                  "description": "Match day number"
                },
                "seasonId": {
                  "type": "string",
                  "format": "vf:season:{id}"
                },
                "seasonName": {
                  "type": "string",
                  "format": "VFLM {number}"
                },
                "seasonStartTime": {
                  "type": "integer",
                  "format": "epoch_milliseconds",
                  "description": "Season start timestamp"
                }
              }
            },
            "prev": {
              "type": "object|null",
              "description": "Previous page (null when matchDay=1, no previous results exist)",
              "fields": "same as current"
            },
            "after": {
              "type": "object|null",
              "description": "Next page (null when at latest match day)",
              "fields": "same as current"
            },
            "results": {
              "type": "array",
              "description": "List of match results (8 per match day, one per fixture)",
              "items": {
                "homeTeam": {
                  "type": "string",
                  "description": "Home team name"
                },
                "awayTeam": {
                  "type": "string",
                  "description": "Away team name"
                },
                "fullTime": {
                  "type": "string",
                  "format": "H:M",
                  "description": "Full-time score"
                },
                "halfTime": {
                  "type": "string",
                  "format": "H:M",
                  "description": "Half-time score"
                },
                "firstGoal": {
                  "type": "string",
                  "enum": [
                    "Home",
                    "Away",
                    "None"
                  ],
                  "description": "Which team scored first"
                }
              }
            }
          }
        }
      }
    },
