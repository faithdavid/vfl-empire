  "key_insights": {
    "pagination": "The results API uses a prev/current/after triple for pagination. prev is null when matchDay=1. after is null when at the latest completed match day.",
    "season_structure": "Each season spans ~3.7 hours of real time. matchDayStartTime advances ~220 seconds per match day. Each season has 18 match days × 8 fixtures.",
    "id_scheme": "All IDs use namespaced prefixes: vf:season:, vf:match:, vf:tournament:, vf:sport:, sr:competitor:, sr:category:",
    "odds_format": "All odds are decimal odds stored as strings (not floats). Probability field is always '0.0000'.",
    "rank_changes": "Ranks change between match days (UP/DOWN/SAME). 54% of teams keep the same rank, ~25% move up, ~24% move down.",
    "pre_match_data": "All captured events are pre-match (status=0, hasLive=0, scoreOfWholeMatch=0:0). Live fields would populate during match execution.",
    "market_id_system": "Market IDs are Sportradar standard: 1=1X2, 10=Double Chance, 11=DNB, 18=Over/Under, 29=GG/NG"
  }
