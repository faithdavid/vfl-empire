  {
   "cell_type": "markdown",
   "source": [
    "## 🎯 Survivorship Bias — Bullet Hole Map\n",
    "\n",
    "We analyze **every missed prediction** to find the real weaknesses."
   ],
   "metadata": {}
  },
  {
   "cell_type": "code",
   "source": [
    "from collections import Counter\n",
    "\n",
    "DATA = WORK/'vfl-empire-repo'/'data'/'consolidated'\n",
    "with open(DATA/'all_consolidated_joined.json') as f:\n",
    "    joined = json.load(f)\n",
    "print(f'Loaded {len(joined)} joined matches')\n",
    "\n",
    "def odds_to_probs(oh, od, oa):\n",
    "    ti = 1/oh+1/od+1/oa; return 1/oh/ti, 1/od/ti, 1/oa/ti\n",
    "\n",
    "def pick_fav(oh, od, oa):\n",
    "    p = odds_to_probs(oh, od, oa)\n",
    "    return max([(0,p[0]),(1,p[1]),(2,p[2])], key=lambda x:x[1])[0]\n",
    "\n",
    "# Classify every match\n",
    "misses = []\n",
    "categories = {'short_fav':0,'mod_fav':0,'long_fav':0}\n",
    "miss_categories = {'short_fav':0,'mod_fav':0,'long_fav':0}\n",
    "league_hits = Counter(); league_misses = Counter()\n",
    "upset_types = Counter()\n",
    "\n",
    "for m in joined:\n",
    "    oh = m.get('odds_h',2.0); od = m.get('odds_d',3.3); oa = m.get('odds_a',2.8)\n",
    "    fh = m.get('ft_home', m.get('home_goals')); fa = m.get('ft_away', m.get('away_goals'))\n",
    "    out = m.get('outcome')\n",
    "    if out is None:\n",
    "        if fh is None: continue\n",
    "        out = 0 if fh > fa else (2 if fh < fa else 1)\n",
    "    fav = pick_fav(oh, od, oa)\n",
    "    league = m.get('league','unknown')\n",
    "    fav_odds = [oh,od,oa][fav]\n",
    "    \n",
    "    # Categorize by odds\n",
    "    if fav_odds < 1.5: cat = 'short_fav'\n",
    "    elif fav_odds < 2.5: cat = 'mod_fav'\n",
    "    else: cat = 'long_fav'\n",
    "    categories[cat] += 1\n",
    "    league_total[league] += 1\n",
    "    \n",
    "    if fav == out:  # Market favorite won = our baseline would have hit\n",
    "        league_hits[league] += 1\n",
    "    else:  # MISS = bullet hole\n",
    "        miss_categories[cat] += 1\n",
    "        league_misses[league] += 1\n",
    "        upset_types[['home_upset','draw','away_upset'][out]] += 1\n",
    "        misses.append({'odds':(oh,od,oa),'fav':fav,'actual':out,'cat':cat,\n",
    "                      'home':m.get('home',''),'away':m.get('away',''),'league':league})\n",
    "\n",
    "total = len(joined)\n",
    "n_misses = len(misses)\n",
    "print(f'\\n{\"=\"*70}')\n",
    "print(f'  🎯 SURVIVORSHIP BIAS — BULLET HOLE MAP')\n",
    "print(f'{\"=\"*70}')\n",
    "print(f'  Total matches:   {total}')\n",
    "print(f'  Missed (bullets): {n_misses} ({n_misses/total*100:.1f}%)')\n",
    "print(f'  Baseline (favs):  {total-n_misses} ({(total-n_misses)/total*100:.1f}%)')\n",
    "\n",
    "print(f'\\n  {"📊 BULLET HOLE DENSITY BY FAVORITE ODDS":^60}')\n",
    "print(f'  {\"-\"*60}')\n",
    "for cat, label in [('short_fav','Short fav ≤1.5'),('mod_fav','Mod fav 1.5-2.5'),('long_fav','Long fav >2.5')]:\n",
    "    c = miss_categories[cat]; t = categories[cat]\n",
    "    pct = c/t*100 if t else 0\n",
    "    bar = '█'*int(pct/2)+'░'*(20-int(pct/2))\n",
    "    print(f'  {label:>25s}: {c:4d}/{t:4d} {bar} {pct:.1f}% miss rate')\n",
    "\n",
    "print(f'\\n  {"📊 UPSET TYPE DISTRIBUTION":^60}')\n",
    "print(f'  {\"-\"*60}')\n",
    "for ut, c in upset_types.most_common():\n",
    "    print(f'  {ut:>20s}: {c:4d} (\"{\"▓\"*int(c/n_misses*30)}\" {c/n_misses*100:.1f}%)')\n",
    "\n",
    "print(f'\\n  {"📊 LEAGUE BULLET HOLE DENSITY (top 10)":^60}')\n",
    "print(f'  {\"-\"*60}')\n",
    "for league, t in league_total.most_common(15):\n",
    "    h = league_hits.get(league,0); m = league_misses.get(league,0); total_l = h+m\n",
    "    if total_l >= 10:\n",
    "        pct = m/total_l*100\n",
    "        bar = '█'*int(pct/2)+'░'*(20-int(pct/2))\n",
    "        print(f'  {league[:22]:>22s}: {m:4d}/{total_l:4d} {bar} {pct:.1f}%')\n",
    "\n",
    "# Save analysis\n",
    "analysis = {\n",
    "    'total_matches': total, 'misses': n_misses, 'miss_rate': n_misses/total,\n",
    "    'by_odds_range': {k:{'total':categories[k],'misses':miss_categories[k]} for k in categories},\n",
    "    'upset_types': dict(upset_types),\n",
    "    'insight': 'Survivorship bias: bullet holes are missed predictions, not random noise'\n",
    "}\n",
    "with open('/content/survivorship_analysis.json','w') as f:\n",
    "    json.dump(analysis, f, indent=2)\n",
    "print(f'\\n✅ Survivorship analysis saved to Drive')"
   ],
